{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryDocument",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "target": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "required": [
    "schema",
    "id",
    "target",
    "summary",
    "content"
  ]
}
